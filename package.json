{
  "name": "docs-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recherche plein texte dans une arborescence docs.numerique.gouv.fr (instantanés Markdown + ripgrep)",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "docs:login": "node src/cli.ts login",
    "docs:sync": "node src/cli.ts sync",
    "docs:search": "node src/cli.ts search",
    "docs:list": "node src/cli.ts list",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "dependencies": {
    "playwright": "1.63.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
